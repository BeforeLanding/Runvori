<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: neither cloud backup nor device transfer may carry the pairing
     credential or the cached session content. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="runvori.credentials.xml" />
        <exclude domain="database" path="runvori-cache.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="runvori.credentials.xml" />
        <exclude domain="database" path="runvori-cache.db" />
    </device-transfer>
</data-extraction-rules>
