<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext, and no user-installed CA is trusted for the Host: the
     identity check is the SPKI pin from the pairing payload. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
